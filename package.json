{
  "name": "@govuk-one-login/data-npm",
  "version": "0.0.13",
  "private": false,
  "description": "Standardised logger for GOV.UK One Login data pod Lambda functions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/govuk-one-login/data-npm"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": "./dist/index.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --coverage",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint --max-warnings 0 --fix .",
    "lint:check": "eslint --max-warnings 0 .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "secret_scan": "betterleaks dir . -v",
    "secret_scan:git": "betterleaks git .",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.35.0",
    "@aws-lambda-powertools/metrics": "^2.35.0",
    "@aws-lambda-powertools/tracer": "^2.35.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node24": "^24.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "@types/aws-lambda": "^8.10.163",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
